      "sceneLines": {
        "signalDisabled": {
          "speaker": "elder",
          "text": "传令绳断了。棚里的人得自己来收拾残局。"
        },
        "exposedOfficer": {
          "speaker": "officer",
          "text": "密捕令烧掉！拦住他们，后面的交接照旧！"
        },
        "exposedPrincess": {
          "speaker": "princess",
          "text": "原令在桌上，运输底页在箱里。人也要带出去！"
        },
        "withdraw": {
          "speaker": "elder",
          "text": "沿南侧旧路撤，我看着后面。别把人落在营地！"
        },
        "workerDeparture": {
          "speaker": "worker",
          "text": "路清了，我们往渡口去。你们也当心。"
        },
        "recordsTaken": {
          "speaker": "player",
          "text": "原令到手。印和落款，都留着核对。"
        },
        "ledgerTaken": {
          "speaker": "player",
          "text": "底页还在。除了粮车，他们还押着人。"
        },
        "workersFreed": {
          "speaker": "worker",
          "text": "我们是被扣来装粮的！带我们离开这儿！"
        },
        "healed": {
          "speaker": "princess",
          "text": "伤口先处理好。接下来我跟着你。"
        },
        "officerEscaped": {
          "speaker": "elder",
          "text": "押运官往北跑了。先带人和文书出去，别空手追进第二道岗。"
        },
        "reinforcements": {
          "speaker": "elder",
          "text": "北哨的援兵到了，传令架还没断！"
        },
        "rescueComplete": {
          "speaker": "worker",
          "text": "到了……文书都在你那里？我们可以作证。"
        }
      }
    }
