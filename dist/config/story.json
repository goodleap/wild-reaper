      "dialogue": {
        "awakening": [
          {"speaker": "player", "text": "我本是昭衡国王子。论剑术、论风度，谁敢与我争锋？"},
          {"speaker": "player", "text": "可沈玄策借镇界仪式夺权，把我推下祭井，还诬我引来灾变。"},
          {"speaker": "player", "text": "我重生了……这一次，绝不重蹈覆辙。先循着林间道路离开营地。"}
        ],
        "search": [{"speaker": "player", "text": "脚步声……有人在搜林。先看清退路。"}],
        "escape": [{"speaker": "player", "text": "被发现了！东边谷地有路，不能在这里被围住。"}],
        "escort": [
          {"speaker": "princess", "text": "那枚佩饰……你是昭衡的王子？"},
          {"speaker": "player", "text": "若你是来领赏的，能否晚些再谈？"},
          {"speaker": "princess", "text": "我是霁川公主。先跟我走，路口还能争取一点时间！"}
        ],
        "pill": [
          {"speaker": "princess", "text": "拿着这颗燃脉丸。服下后能激发潜力，但药力只有二十秒。"},
          {"speaker": "princess", "text": "前面的誓约之地能唤来守望者。跟紧我，到那里再掩护我召唤。"},
          {"speaker": "player", "text": "你带路，我来击退追兵！"}
        ],
        "burst": [{"speaker": "player", "text": "这股力量……王庭剑阵，随我破敌！"}],
        "fading": [
          {"speaker": "player", "text": "剑……怎么突然这么沉？药效尽了！"},
          {"speaker": "princess", "text": "别逞强！往采石盆地走，守望者已回应祈愿！"}
        ],
        "sanctuary": [
          {"speaker": "princess", "text": "药效燃尽了！跟紧我，留在天使的守护光环里，撑到引雷完成！"}
        ],
        "judgment": [{"speaker": "angel", "text": "此雷为护生而降——退开！"}],
        "conversation": [
          {"speaker": "player", "text": "我死于摄政沈玄策之手。他夺了王国，还在搜捕这些人。"},
          {"speaker": "princess", "text": "我追查押运队才来到林海。失踪的难民，都被送往祭场。"},
          {"speaker": "angel", "text": "林海北方留有押运痕迹。真相，需要你们自己去找。"},
          {"speaker": "player", "text": "我曾只想着夺回王位。这一次，先救人，再讨旧账。"},
          {"speaker": "princess", "text": "等安顿好获救的人，我们一同启航。王子，这一次，别再独自迎战。"}
        ]
      }
