          "swords": [
            "王庭剑阵，起！",
            "诸剑听令，护我破阵！",
            "这一剑，不再为虚名！"
          ],
          "forest": [
            "以前出巡有人开路，如今得自己认路。",
            "林子太静，脚步放轻些。",
            "王冠不在，剑还握得稳。"
          ],
          "marsh": [
            "水痕有新有旧，脚下得多留神。",
            "宫里的靴子，可经不起这片泥水。",
            "雾里看不清，先认准归路。"
          ],
          "ruins": [
            "旧日城墙还在，主人却不知去了哪里。",
            "能守住人的，终究不只是高墙。",
            "这些断石，倒像没说完的话。"
          ],
          "interior": [
            "门后的风声变了，小心暗处。",
            "先记住出口，再找别的。",
            "宝物会等人，机关可不会。"
          ]
        },
        "princess": {
          "hurt": [
            "伤得不重，别乱了阵脚。",
            "还能撑住，先看清敌人。",
            "稳住呼吸，别停在这里。"
          ],
          "alert": [
            "强敌来了，守好退路。",
            "留神它的起手。",
            "别急，先看清它的位置。"
          ],
          "surrounded": [
            "它们在合围，往空处走！",
            "敌人增多了，保持距离！",
            "跟紧些，别被分开！"
          ],
          "retreat": [
            "先退到安全处，我还能撑住。",
            "伤势不能再拖，撤！",
            "这条路太险，先退！"
          ],
          "determined": [
            "别慌，一步一步来。",
            "人多也有空隙，盯住它。",
            "先守住我们身后的路。"
          ],
          "encourage": [
            "阵形还稳，我们能过去！",
            "相互照应，别落下人。",
            "很好，再向前一步！"
          ],
          "storm": [
            "雷光，照亮前路！",
            "天雷落下，都退开！",
            "这一击，护住大家！"
          ],
          "meteor": [
            "星光落处，让出道路！",
            "星陨，截住它们！",
            "别靠近，星陨将至！"
          ],
          "swords": [
            "诸剑列阵，护住此地！",
            "王庭剑阵，守住退路！",
            "剑阵已起，跟我走！"
          ],
          "forest": [
            "这里有人经过，脚印还很新。",
            "树荫能遮阳，也藏得住危险。",
            "先认好方向，别在林间绕远。"
          ],
          "marsh": [
            "芦苇在动，先别靠得太近。",
            "水边的路，踩实了再走。",
            "雾再浓，也得留一条归路。"
          ],
          "ruins": [
            "这里也曾有人等亲人回家吧。",
            "石缝里的草，倒比城墙更顽强。",
            "别惊动暗处，慢些看。"
          ],
          "interior": [
            "先找出口，别被珍藏引走了神。",
            "墙后的声音，听清再前进。",
            "我来记路，大家留神脚下。"
          ]
        },
        "elder": {
          "hurt": [
            "啧，老骨头也不是白练的。",
            "这一下还成，记你一笔。",
            "皮肉伤，别给它第二下。"
          ],
          "alert": [
            "硬茬来了，手脚利索些。",
            "别看它架势大，先找破绽。",
            "老夫可还没眼花。"
          ],
          "surrounded": [
            "想包饺子？先留条退路。",
            "这群东西，倒会挑时候。",
            "别挤一处，找空当走！"
          ],
          "retreat": [
            "打不过就换个地方打，走！",
            "留得老命在，不怕没柴烧！",
            "今天不跟它们讲道理，撤！"
          ],
          "determined": [
            "年纪大，胆子可没小！",
            "来得多，省得老夫挨个找。",
            "稳当点，胜负还早。"
          ],
          "encourage": [
            "就这劲头，接着打！",
            "别急，老夫还站着呢。",
            "手别软，路就在前头！"
          ],
          "storm": [
            "雷来！给老夫清静清静！",
            "天雷落了，谁也别逞强！",
            "听个响，醒醒神！"
          ],
          "meteor": [
            "抬头，老夫请你们看星星！",
            "星陨，砸开这条路！",
            "让开些，这下可不轻！"
          ],
          "swords": [
            "剑阵起，别踩错地方！",
            "老夫的剑，还认得路！",
            "诸剑列阵，收拾收拾它们！"
          ],
          "forest": [
            "林子太安静，通常没什么好事。",
            "这路老夫认得……大概。",
            "走慢两步，眼睛能多看一处。"
          ],
          "marsh": [
            "这泥巴，比年轻时还黏人。",
            "草长得好，不见得脚下是实地。",
            "闻着不对劲，绕一步不吃亏。"
          ],
          "ruins": [
            "城能塌，人得站稳。",
            "当年修这墙的人，手艺不错。",
            "断墙底下，多半有故事也有东西。"
          ],
          "interior": [
            "进门先记路，老规矩。",
            "好东西若摆得太显眼，多留个心眼。",
            "别忙着伸手，看看脚底。"
          ]
        }
